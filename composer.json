{
    "name": "atwx/silverstripe-altcha-spamprotection",
    "description": "Silverstripe Spamprotection module using Altcha",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS",
        "altcha",
        "spam",
        "spamprotection",
        "protection",
        "userforms"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.2",
        "silverstripe/framework": "^5.0|^6.0",
        "silverstripe/userforms": "^6.0|^7.0",
        "silverstripe/spamprotection": "^4.0|^5.0",
        "altcha-org/altcha": "^1.1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\SilverstripeAltchaSpamprotection\\": "src/",
            "Atwx\\SilverstripeAltchaSpamprotection\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client"
        ],
        "project-files-installed": [
            "phpunit.xml.dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true,
            "silverstripe/recipe-plugin": true
        }
    }
}
